  "learningJourneyStageFiqhDailyLifeTitle": "Daily Life Scenarios",
  "learningJourneyStageFiqhDailyLifeSummary": "Apply simple fiqh thinking to ordinary questions and choices.",
  "learningJourneyStageFiqhCompletionTitle": "Practical Review",
  "learningJourneyStageFiqhCompletionSummary": "Review the essentials and choose the next ibadah journey to strengthen.",
  "learningJourneyStageTimelineEarlyProphetsTitle": "Early Prophets Overview",
  "learningJourneyStageTimelineEarlyProphetsSummary": "Start with the earliest prophetic stories and the pattern they establish.",
  "learningJourneyStageTimelineProphetEraTitle": "The Era of Prophet Muhammad",
  "learningJourneyStageTimelineProphetEraSummary": "See how revelation transformed a community during the life of the Prophet.",
  "learningJourneyStageTimelineKhulafaTitle": "The Rightly Guided Caliphs",
  "learningJourneyStageTimelineKhulafaSummary": "Learn how leadership continued after the Prophet with service and responsibility.",
  "learningJourneyStageTimelineExpansionTitle": "Expansion of Islam",
  "learningJourneyStageTimelineExpansionSummary": "Understand how Islam spread across lands, peoples, and cultures.",
  "learningJourneyStageTimelineGoldenAgeTitle": "The Golden Age",
