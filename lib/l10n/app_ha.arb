  "homeGlassPreviewTitle": "Glass Style Preview",
  "homeGlassPreviewSubtitle": "Temporary visual comparison of surface styles for calm homepage islands.",
  "homeGlassPreviewFootnote": "Preview only — not yet applied across the app. This section is temporary and safe to remove after a glass direction is chosen.",
  "homeGlassPreviewLegend": "Layered inner surface sample",
  "homeGlassPreviewMetaBlur": "Blur",
