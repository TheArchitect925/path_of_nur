<?xml version="1.0" encoding="utf-8"?>
<!-- The launch window: the app's ground colour and the lantern mark, the
     same lantern the Flutter loading screen kindles a moment later. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_lantern" />
    </item>
</layer-list>
