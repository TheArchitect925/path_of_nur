import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';

import '../../../../l10n/app_localizations.dart';
import '../../../../shared/widgets/premium_card.dart';
import '../../journey/application/learning_path_provider.dart';
import '../../journey/domain/learning_path_models.dart';

class LearnPathPickerWidget extends ConsumerStatefulWidget {
  const LearnPathPickerWidget({super.key, required this.onBrowseFreelyTapped});

  final VoidCallback onBrowseFreelyTapped;

  @override
  ConsumerState<LearnPathPickerWidget> createState() =>
      _LearnPathPickerWidgetState();
}

class _LearnPathPickerWidgetState extends ConsumerState<LearnPathPickerWidget> {
  _ExistingMuslimFocus? _selectedFocus;

  @override
  Widget build(BuildContext context) {
    final l10n = AppLocalizations.of(context);
    final notifier = ref.read(learningPathSelectionProvider.notifier);

    return PremiumCard(
      padding: const EdgeInsets.all(20),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Text(
            l10n.learnHubChoosePathTitle,
            style: Theme.of(
              context,
            ).textTheme.titleMedium?.copyWith(fontWeight: FontWeight.w700),
          ),
          const SizedBox(height: 6),
          Text(
            l10n.learnHubChoosePathSubtitle,
            style: Theme.of(context).textTheme.bodyMedium,
          ),
          const SizedBox(height: 16),
          LayoutBuilder(
            builder: (context, constraints) {
              final stacked = constraints.maxWidth < 560;
              final children = [
                _LearnPathOptionCard(
                  title: l10n.learnHubPathOptionNewTitle,
                  description: l10n.learnHubPathOptionNewDescription,
                  onTap: () => notifier.setLevel(LearningPathLevel.beginner),
                ),
                _LearnPathOptionCard(
                  title: l10n.learnHubPathOptionDeepenTitle,
                  description: l10n.learnHubPathOptionDeepenDescription,
                  onTap: () {
                    setState(() {
                      _selectedFocus ??= _ExistingMuslimFocus.quranArabic;
                    });
                  },
                ),
              ];

              if (stacked) {
                return Column(
                  children: [
                    children[0],
                    const SizedBox(height: 12),
                    children[1],
                  ],
                );
              }

              return Row(
                children: [
                  Expanded(child: children[0]),
                  const SizedBox(width: 12),
                  Expanded(child: children[1]),
                ],
              );
            },
          ),
          if (_selectedFocus != null) ...[
            const SizedBox(height: 16),
            Text(
              l10n.learnHubPathFocusPrompt,
              style: Theme.of(
                context,
              ).textTheme.bodyMedium?.copyWith(fontWeight: FontWeight.w600),
            ),
            const SizedBox(height: 10),
            Wrap(
              spacing: 8,
              runSpacing: 8,
              children: _ExistingMuslimFocus.values
                  .map((focus) {
                    return ChoiceChip(
                      label: Text(focus.label(l10n)),
                      selected: _selectedFocus == focus,
                      onSelected: (_) {
                        setState(() => _selectedFocus = focus);
                      },
                    );
                  })
                  .toList(growable: false),
            ),
            const SizedBox(height: 12),
            FilledButton(
              onPressed: () {
                final focus = _selectedFocus;
                if (focus == null) return;
                notifier.setLevel(focus.level);
                notifier.recordJourneyInteraction(focus.journeyId);
              },
              child: Text(l10n.learnHubPathStartSelectedPathAction),
            ),
          ],
          const SizedBox(height: 8),
          TextButton(
            onPressed: widget.onBrowseFreelyTapped,
            child: Text(l10n.learnHubPathCardBrowseFreelyAction),
          ),
        ],
      ),
    );
  }
}

class _LearnPathOptionCard extends StatelessWidget {
  const _LearnPathOptionCard({
    required this.title,
    required this.description,
    required this.onTap,
  });

  final String title;
  final String description;
  final VoidCallback onTap;

  @override
  Widget build(BuildContext context) {
    final l10n = AppLocalizations.of(context);
    return PremiumCard(
      padding: const EdgeInsets.all(16),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Text(
            title,
            style: Theme.of(
              context,
            ).textTheme.titleSmall?.copyWith(fontWeight: FontWeight.w700),
          ),
          const SizedBox(height: 8),
          Text(description, style: Theme.of(context).textTheme.bodyMedium),
          const SizedBox(height: 14),
          FilledButton(
            onPressed: onTap,
            child: Text(l10n.learnHubPathGetStartedAction),
          ),
        ],
      ),
    );
  }
}

enum _ExistingMuslimFocus {
  quranArabic(journeyId: 'reading-basics', level: LearningPathLevel.seeker),
  hadithDeepDive(
    journeyId: 'hadith-essentials',
    level: LearningPathLevel.seeker,
  ),
  seerahProphets(journeyId: 'seerah-journey', level: LearningPathLevel.seeker),
  characterAdab(
    journeyId: 'beautiful-character',
    level: LearningPathLevel.practicing,
  );

  const _ExistingMuslimFocus({required this.journeyId, required this.level});

  final String journeyId;
  final LearningPathLevel level;

  String label(AppLocalizations l10n) {
    return switch (this) {
      _ExistingMuslimFocus.quranArabic => l10n.learnHubPathFocusQuranArabic,
      _ExistingMuslimFocus.hadithDeepDive =>
        l10n.learnHubPathFocusHadithDeepDive,
      _ExistingMuslimFocus.seerahProphets =>
        l10n.learnHubPathFocusSeerahProphets,
      _ExistingMuslimFocus.characterAdab => l10n.learnHubPathFocusCharacterAdab,
    };
  }
}
