import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:go_router/go_router.dart';

import '../../../../core/theme/app_colors.dart';
import '../../../../l10n/app_localizations.dart';
import '../../../../shared/widgets/premium_card.dart';

class LearnFreeBrowseCard extends ConsumerStatefulWidget {
  const LearnFreeBrowseCard({super.key});

  @override
  ConsumerState<LearnFreeBrowseCard> createState() =>
      _LearnFreeBrowseCardState();
}

class _LearnFreeBrowseCardState extends ConsumerState<LearnFreeBrowseCard> {
  bool _expanded = false;

  @override
  Widget build(BuildContext context) {
    final l10n = AppLocalizations.of(context);
    final theme = Theme.of(context);
    final groups = _buildGroups(l10n);

    return Material(
      color: Colors.transparent,
      child: DecoratedBox(
        decoration: BoxDecoration(
          borderRadius: BorderRadius.circular(36),
          border: Border.all(
            color: AppColors.onSurfaceSubtle.withValues(alpha: 0.16),
          ),
        ),
        child: PremiumCard(
          padding: const EdgeInsets.all(20),
          surfaceTintColor: AppColors.caution.withValues(alpha: 0.08),
          includeShadow: false,
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              InkWell(
                borderRadius: BorderRadius.circular(24),
                onTap: () => setState(() => _expanded = !_expanded),
                child: Padding(
                  padding: const EdgeInsets.all(4),
                  child: Row(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      Expanded(
                        child: Column(
                          crossAxisAlignment: CrossAxisAlignment.start,
                          children: [
                            Text(
                              l10n.learnFreeBrowseCardTitle,
                              style: theme.textTheme.titleMedium?.copyWith(
                                fontWeight: FontWeight.w700,
                              ),
                            ),
                            const SizedBox(height: 6),
                            Text(
                              l10n.learnFreeBrowseCardSubtitle,
                              style: theme.textTheme.bodySmall?.copyWith(
                                color: AppColors.onSurfaceSubtle,
                              ),
                            ),
                          ],
                        ),
                      ),
                      const SizedBox(width: 16),
                      Icon(
                        _expanded
                            ? Icons.keyboard_arrow_up_rounded
                            : Icons.keyboard_arrow_down_rounded,
                      ),
                    ],
                  ),
                ),
              ),
              if (_expanded) ...[
                const SizedBox(height: 18),
                ConstrainedBox(
                  constraints: const BoxConstraints(maxHeight: 360),
                  child: SingleChildScrollView(
                    child: Column(
                      crossAxisAlignment: CrossAxisAlignment.start,
                      children: [
                        for (var index = 0; index < groups.length; index++) ...[
                          _LegacyGroupSection(
                            group: groups[index],
                            onItemTap: (item) => _openItem(context, item),
                          ),
                          if (index != groups.length - 1)
                            const SizedBox(height: 18),
                        ],
                      ],
                    ),
                  ),
                ),
              ],
            ],
          ),
        ),
      ),
    );
  }

  List<_LegacyContentGroup> _buildGroups(AppLocalizations l10n) {
    return [
      _LegacyContentGroup(
        title: l10n.learnLegacyGroupJourneys,
        items: const [
          // TODO: add l10n keys for legacy item labels if this card remains.
          _LegacyContentItem(
            label: 'Learning Journey Home',
            routeName: 'learnJourneyHome',
          ),
          _LegacyContentItem(
            label: 'Journey Islands',
            routeName: 'learnJourneyIslandHub',
          ),
          _LegacyContentItem(
            label: 'Games Island',
            routeName: 'learnGamesIsland',
          ),
        ],
      ),
      _LegacyContentGroup(
        title: l10n.learnLegacyGroupQuranLearning,
        items: const [
          // TODO: add l10n keys for legacy item labels if this card remains.
          _LegacyContentItem(
            label: "Qur'an Learning Hub",
            routeName: 'learnQuranHub',
          ),
          _LegacyContentItem(
            label: "Qur'an Insights Browse",
            routeName: 'quranAyahInsightsBrowse',
          ),
          _LegacyContentItem(
            label: "Qur'an Knowledge Search",
            routeName: 'quranKnowledgeSearch',
          ),
          _LegacyContentItem(
            label: "Qur'an Summaries",
            routeName: 'quranSummaryPage',
          ),
          _LegacyContentItem(
            label: "Qur'an Learning Paths",
            routeName: 'quranLearningPaths',
          ),
          _LegacyContentItem(
            label: "Qur'anic Arabic Modules",
            routeName: 'quranArabic',
          ),
          _LegacyContentItem(
            label: "Qur'an Universe",
            routeName: 'quranUniverse',
          ),
          _LegacyContentItem(
            label: 'Daily Companion',
            routeName: 'quranDailyCompanion',
          ),
        ],
      ),
      _LegacyContentGroup(
        title: l10n.learnLegacyGroupDeepDive,
        items: const [
          // TODO: add l10n keys for legacy item labels if this card remains.
          _LegacyContentItem(
            label: 'Divine Life Lessons',
            routeName: 'learnLifeLanding',
          ),
          _LegacyContentItem(
            label: 'Character Companion',
            routeName: 'learnCharacterCompanion',
          ),
          _LegacyContentItem(
            label: 'Seerah Companion',
            routeName: 'learnSeerahCompanion',
          ),
          _LegacyContentItem(
            label: 'Daily Wisdom Companion',
            routeName: 'learnDailyWisdomCompanion',
          ),
          _LegacyContentItem(
            label: 'Prophets Hub',
            routeName: 'learnProphetsHub',
          ),
          _LegacyContentItem(label: 'Baby Names', routeName: 'babyNamesHome'),
        ],
      ),
      _LegacyContentGroup(
        title: l10n.learnLegacyGroupQuizzes,
        items: const [
          // TODO: add l10n keys for legacy item labels if this card remains.
          _LegacyContentItem(
            label: 'Quizzes Hub',
            routeName: 'learnQuizzesHub',
          ),
          _LegacyContentItem(
            label: 'Trivia',
            routeName: 'learnQuizzesTriviaHome',
          ),
          _LegacyContentItem(
            label: 'Daily Knowledge Quiz',
            routeName: 'learnDailyKnowledgeHub',
          ),
          _LegacyContentItem(
            label: 'Crossword',
            routeName: 'learnCrosswordHome',
          ),
          _LegacyContentItem(
            label: 'Word Search',
            routeName: 'learnWordSearchHome',
          ),
          _LegacyContentItem(
            label: 'Matching Game',
            routeName: 'learnMatchingHome',
          ),
          _LegacyContentItem(
            label: 'Ayah Completion',
            routeName: 'learnAyahCompletionHome',
          ),
          _LegacyContentItem(
            label: 'Hadith Reflection Quiz',
            routeName: 'learnHadithReflectionHome',
          ),
        ],
      ),
      _LegacyContentGroup(
        title: l10n.learnLegacyGroupKids,
        items: const [
          // TODO: add l10n keys for legacy item labels if this card remains.
          _LegacyContentItem(label: 'Kids Games', routeName: 'learnKidsGames'),
          _LegacyContentItem(label: "Kids Qur'an", routeName: 'learnKidsQuran'),
          _LegacyContentItem(
            label: 'Kids Hadith',
            routeName: 'learnKidsHadith',
          ),
          _LegacyContentItem(
            label: 'Prophet Stories (Kids)',
            routeName: 'learnKidsProphetStories',
          ),
          _LegacyContentItem(
            label: 'Fun Learning',
            routeName: 'learnKidsFunLearning',
          ),
          _LegacyContentItem(label: 'Kids Arabic', routeName: 'kidsArabicHome'),
          _LegacyContentItem(
            label: 'Bedtime Stories',
            routeName: 'kidsBedtimeStories',
          ),
          _LegacyContentItem(
            label: 'Seerah Journeys (Kids)',
            routeName: 'kidsSeerahJourneys',
          ),
          _LegacyContentItem(label: 'Kids Dua', routeName: 'kidsDuaLanding'),
        ],
      ),
      _LegacyContentGroup(
        title: l10n.learnLegacyGroupReference,
        items: const [
          // TODO: add l10n keys for legacy item labels if this card remains.
          _LegacyContentItem(
            label: 'Islamic Guides',
            routeName: 'islamicGuides',
          ),
          _LegacyContentItem(
            label: "Qur'an Lessons Mapping",
            routeName: 'quranLessonsMapping',
          ),
          _LegacyContentItem(label: 'FAQ', routeName: 'faqLanding'),
          _LegacyContentItem(label: 'Glossary', routeName: 'learnGlossary'),
          _LegacyContentItem(
            label: 'Islamic History',
            routeName: 'learnHistoryArchive',
          ),
        ],
      ),
    ];
  }

  void _openItem(BuildContext context, _LegacyContentItem item) {
    if (item.routeName == null) {
      // TODO: confirm route — using placeholder fallback until route is verified.
      ScaffoldMessenger.of(
        context,
      ).showSnackBar(const SnackBar(content: Text('Route TBD')));
      return;
    }

    context.pushNamed(item.routeName!);
  }
}

class _LegacyGroupSection extends StatelessWidget {
  const _LegacyGroupSection({required this.group, required this.onItemTap});

  final _LegacyContentGroup group;
  final ValueChanged<_LegacyContentItem> onItemTap;

  @override
  Widget build(BuildContext context) {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        Text(
          group.title,
          style: Theme.of(context).textTheme.labelSmall?.copyWith(
            fontSize: 12,
            color: AppColors.onSurfaceSubtle,
            fontWeight: FontWeight.w600,
          ),
        ),
        const SizedBox(height: 8),
        for (final item in group.items)
          _LegacyContentRow(item: item, onTap: () => onItemTap(item)),
      ],
    );
  }
}

class _LegacyContentRow extends StatelessWidget {
  const _LegacyContentRow({required this.item, required this.onTap});

  final _LegacyContentItem item;
  final VoidCallback onTap;

  @override
  Widget build(BuildContext context) {
    return Material(
      color: Colors.transparent,
      child: InkWell(
        onTap: onTap,
        borderRadius: BorderRadius.circular(16),
        child: Padding(
          padding: const EdgeInsets.symmetric(vertical: 10, horizontal: 4),
          child: Row(
            children: [
              const Icon(Icons.arrow_outward_rounded, size: 18),
              const SizedBox(width: 10),
              Expanded(
                child: Text(
                  item.label,
                  style: Theme.of(context).textTheme.bodyMedium,
                ),
              ),
            ],
          ),
        ),
      ),
    );
  }
}

class _LegacyContentGroup {
  const _LegacyContentGroup({required this.title, required this.items});

  final String title;
  final List<_LegacyContentItem> items;
}

class _LegacyContentItem {
  const _LegacyContentItem({required this.label, this.routeName});

  final String label;
  final String? routeName;
}
