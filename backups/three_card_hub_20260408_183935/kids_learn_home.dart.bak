import 'package:flutter/material.dart';
import 'package:go_router/go_router.dart';

import '../../../../l10n/app_localizations.dart';
import '../../../../shared/widgets/app_page_scaffold.dart';
import '../../../../shared/widgets/premium_card.dart';

class KidsLearnHome extends StatelessWidget {
  const KidsLearnHome({super.key});

  @override
  Widget build(BuildContext context) {
    final l10n = AppLocalizations.of(context);

    return AppPageScaffold(
      headerIcon: Icons.auto_stories_rounded,
      title: l10n.learnHubTitle,
      subtitle: l10n.learnHubKidsHomeSubtitle,
      children: [
        Text(
          l10n.learnHubKidsGreeting,
          style: Theme.of(
            context,
          ).textTheme.headlineSmall?.copyWith(fontWeight: FontWeight.w800),
        ),
        const SizedBox(height: 16),
        LayoutBuilder(
          builder: (context, constraints) {
            final maxWidth = constraints.maxWidth;
            final columns = maxWidth >= 720
                ? 3
                : maxWidth >= 420
                ? 2
                : 1;
            final itemWidth = columns == 1
                ? maxWidth
                : (maxWidth - (12 * (columns - 1))) / columns;
            return Wrap(
              spacing: 12,
              runSpacing: 12,
              children: [
                SizedBox(
                  width: itemWidth,
                  child: _KidsLearnTile(
                    icon: Icons.menu_book_rounded,
                    label: l10n.learnHubKidsProphetStories,
                    onTap: () => context.pushNamed('learnKidsProphetStories'),
                  ),
                ),
                SizedBox(
                  width: itemWidth,
                  child: _KidsLearnTile(
                    icon: Icons.auto_stories_rounded,
                    label: l10n.learnHubKidsQuranBasics,
                    onTap: () => context.pushNamed('learnKidsQuran'),
                  ),
                ),
                SizedBox(
                  width: itemWidth,
                  child: _KidsLearnTile(
                    icon: Icons.favorite_outline_rounded,
                    label: l10n.learnHubKidsDuasIKnow,
                    onTap: () => context.pushNamed('kidsDuaLanding'),
                  ),
                ),
                SizedBox(
                  width: itemWidth,
                  child: _KidsLearnTile(
                    icon: Icons.sports_esports_rounded,
                    label: l10n.learnHubKidsPlayAndLearn,
                    onTap: () => context.pushNamed('learnKidsGames'),
                  ),
                ),
              ],
            );
          },
        ),
      ],
    );
  }
}

class _KidsLearnTile extends StatelessWidget {
  const _KidsLearnTile({
    required this.icon,
    required this.label,
    required this.onTap,
  });

  final IconData icon;
  final String label;
  final VoidCallback onTap;

  @override
  Widget build(BuildContext context) {
    return Material(
      color: Colors.transparent,
      child: InkWell(
        borderRadius: BorderRadius.circular(24),
        onTap: onTap,
        child: PremiumCard(
          padding: const EdgeInsets.all(16),
          child: ConstrainedBox(
            constraints: const BoxConstraints(minHeight: 80),
            child: Column(
              mainAxisAlignment: MainAxisAlignment.center,
              children: [
                Icon(icon, size: 32),
                const SizedBox(height: 10),
                Text(
                  label,
                  textAlign: TextAlign.center,
                  style: Theme.of(context).textTheme.titleMedium?.copyWith(
                    fontSize: 18,
                    fontWeight: FontWeight.w700,
                  ),
                ),
              ],
            ),
          ),
        ),
      ),
    );
  }
}
