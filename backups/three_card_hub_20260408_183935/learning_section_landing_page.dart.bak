import '../../../../l10n/app_localizations.dart';
import '../../../../shared/application/special_mode_provider.dart';
import '../../../../shared/widgets/app_page_scaffold.dart';
import '../../journey/application/learning_journey_progress_provider.dart';
import '../../journey/application/learning_path_provider.dart';
import '../../journey/data/learning_journey_localized_metadata.dart';
import '../../journey/data/learning_journey_registry.dart';
import '../../journey/data/learning_path_registry.dart';
import '../../journey/domain/learning_journey_models.dart';
import '../../journey/domain/learning_path_models.dart';
import '../widgets/kids_learn_home.dart';
import '../widgets/learn_explore_pillars_widget.dart';
import '../widgets/learn_free_browse_card.dart';
import '../widgets/learn_path_picker_widget.dart';
import '../widgets/learn_your_path_card.dart';

class LearningSectionLandingPage extends ConsumerStatefulWidget {
  const LearningSectionLandingPage({super.key});

  @override
  ConsumerState<LearningSectionLandingPage> createState() =>
      _LearningSectionLandingPageState();
}

class _LearningSectionLandingPageState
    extends ConsumerState<LearningSectionLandingPage> {
  final ScrollController _scrollController = ScrollController();
  final GlobalKey _browseTopicsKey = GlobalKey();

  @override
  void dispose() {
    _scrollController.dispose();
    super.dispose();
  }

  void _scrollToBrowseTopics() {
    final context = _browseTopicsKey.currentContext;
    if (context == null) return;
    Scrollable.ensureVisible(
      context,
      duration: const Duration(milliseconds: 280),
      curve: Curves.easeOutCubic,
      alignment: 0.08,
    );
  }

  @override
  Widget build(BuildContext context) {
    final isKids = ref.watch(specialModeProvider).isKids;
    if (isKids) {
      return const KidsLearnHome();
    }

    final l10n = AppLocalizations.of(context);
    final pathState = ref.watch(learningPathStateProvider);
    final continueState = ref.watch(learningJourneyContinueProvider);
    final progress = ref.watch(learningJourneyProgressProvider);
    final pathCardData = pathState == null
        ? null
        : _resolvePathCardData(
            context,
            l10n,
            pathState,
            continueState,
            progress,
          );

    return AppPageScaffold(
      headerIcon: Icons.school_rounded,
      title: l10n.learnHubTitle,
      subtitle: l10n.learnHubLandingCalmSubtitle,
      scrollController: _scrollController,
      children: [
        _SectionHeading(title: l10n.learnHubYourPathSectionTitle),
        const SizedBox(height: 10),
        if (pathCardData == null)
          LearnPathPickerWidget(onBrowseFreelyTapped: _scrollToBrowseTopics)
        else
          LearnYourPathCard(
            pathName: pathCardData.pathName,
            stageName: pathCardData.stageName,
            stagesCompleted: pathCardData.stagesCompleted,
            totalStages: pathCardData.totalStages,
            onBrowseFreelyTapped: _scrollToBrowseTopics,
            onContinue: () => context.pushNamed(
              'learnJourneyStage',
              pathParameters: {
                'journeyId': pathCardData.journeyId,
                'stageId': pathCardData.stageId,
              },
            ),
          ),
        const SizedBox(height: 20),
        _SectionHeading(
          key: _browseTopicsKey,
          title: l10n.learnHubBrowseAllTopicsTitle,
        ),
        const SizedBox(height: 6),
        _SectionSubheading(title: l10n.learnHubBrowseAllSubtitle),
        const SizedBox(height: 10),
        const LearnExplorePillarsWidget(),
        const SizedBox(height: 20),
        Wrap(
          spacing: 12,
          runSpacing: 12,
          children: [
            _UtilityTile(
              icon: Icons.extension_rounded,
              label: l10n.learnHubUtilityQuizzesGames,
              onTap: () => context.pushNamed('learnQuizzesHub'),
            ),
            _UtilityTile(
              icon: Icons.note_alt_outlined,
              label: l10n.learnHubUtilityNotes,
              onTap: () => context.pushNamed('learnNotesLanding'),
            ),
            _UtilityTile(
              icon: Icons.bookmark_border_rounded,
              label: l10n.learnHubUtilitySaved,
              onTap: () => context.pushNamed('quranReflections'),
            ),
          ],
        ),
        const SizedBox(height: 20),
        _SectionHeading(title: l10n.learnHubMoreToExploreSectionTitle),
        const SizedBox(height: 16),
        const LearnFreeBrowseCard(),
      ],
    );
  }
}

class _ResolvedPathCardData {
  const _ResolvedPathCardData({
    required this.pathName,
    required this.stageName,
    required this.stagesCompleted,
    required this.totalStages,
    required this.journeyId,
    required this.stageId,
  });

  final String pathName;
  final String stageName;
  final int stagesCompleted;
  final int totalStages;
  final String journeyId;
  final String stageId;
}

_ResolvedPathCardData? _resolvePathCardData(
  BuildContext context,
  AppLocalizations l10n,
  LearningPathResolvedState pathState,
  LearningJourneyContinueState continueState,
  LearningJourneyProgressState progress,
) {
  final currentJourney = _resolveCurrentJourney(pathState, continueState);
  final currentStage = _resolveCurrentStage(pathState, continueState, progress);
  if (currentJourney == null || currentStage == null) {
    return null;
  }

  final allJourneyIds = pathState.path.phases
      .expand((phase) => phase.journeyIds)
      .toSet();
  final allStages = allJourneyIds
      .map(LearningJourneyRegistry.journeyById)
      .whereType<LearningJourney>()
      .expand((journey) => journey.stageIds)
      .toList(growable: false);
  final completedStages = allStages
      .where(progress.completedStageIds.contains)
      .length;

  return _ResolvedPathCardData(
    pathName: _resolvePathName(context, l10n, pathState),
    stageName: localizedStageTitle(context, currentStage),
    stagesCompleted: completedStages,
    totalStages: allStages.length,
    journeyId: currentJourney.id,
    stageId: currentStage.id,
  );
}

LearningJourney? _resolveCurrentJourney(
  LearningPathResolvedState pathState,
  LearningJourneyContinueState continueState,
) {
  if (continueState.journey != null &&
      pathState.containsJourney(continueState.journey!.id)) {
    return continueState.journey;
  }
  return pathState.primaryJourney ?? pathState.currentPhaseJourneys.firstOrNull;
}

LearningJourneyStage? _resolveCurrentStage(
  LearningPathResolvedState pathState,
  LearningJourneyContinueState continueState,
  LearningJourneyProgressState progress,
) {
  if (continueState.stage != null &&
      continueState.journey != null &&
      pathState.containsJourney(continueState.journey!.id)) {
    return continueState.stage;
  }

  final journey = _resolveCurrentJourney(pathState, continueState);
  if (journey == null) {
    return null;
  }

  for (final stageId in journey.stageIds) {
    if (!progress.completedStageIds.contains(stageId)) {
      return LearningJourneyRegistry.stageById(stageId);
    }
  }

  return journey.stageIds.isEmpty
      ? null
      : LearningJourneyRegistry.stageById(journey.stageIds.last);
}

String _resolvePathName(
  BuildContext context,
  AppLocalizations l10n,
  LearningPathResolvedState pathState,
) {
  final focusJourneyId =
      pathState.persistedState.secondaryExplorationIds.lastOrNull;
  if (focusJourneyId != null) {
    return switch (focusJourneyId) {
      'reading-basics' ||
      '100-quranic-words' => l10n.learnHubPathFocusQuranArabic,
      'hadith-essentials' => l10n.learnHubPathFocusHadithDeepDive,
      'seerah-journey' ||
      'prophets-journey' => l10n.learnHubPathFocusSeerahProphets,
      'beautiful-character' => l10n.learnHubPathFocusCharacterAdab,
      _ => LearningPathRegistry.localizedPathTitle(l10n, pathState.path),
    };
  }

  if (pathState.path.level == LearningPathLevel.beginner) {
    return l10n.learnHubPathOptionNewTitle;
  }

  if (pathState.path.level == LearningPathLevel.practicing ||
      pathState.path.level == LearningPathLevel.seeker ||
      pathState.path.level == LearningPathLevel.advanced) {
    return l10n.learnHubPathOptionDeepenTitle;
  }

  return LearningPathRegistry.localizedPathTitle(l10n, pathState.path);
}

class _SectionHeading extends StatelessWidget {
  const _SectionHeading({super.key, required this.title});

  final String title;

  @override
  Widget build(BuildContext context) {
    return Text(
      title,
      style: Theme.of(
        context,
      ).textTheme.titleSmall?.copyWith(fontWeight: FontWeight.w700),
    );
  }
}

class _SectionSubheading extends StatelessWidget {
  const _SectionSubheading({required this.title});

  final String title;

  @override
  Widget build(BuildContext context) {
    return Text(
      title,
      style: Theme.of(context).textTheme.bodySmall?.copyWith(
        color: Theme.of(context).textTheme.bodySmall?.color,
        fontSize: 12,
      ),
    );
  }
}

class _UtilityTile extends StatelessWidget {
  const _UtilityTile({
    required this.icon,
    required this.label,
    required this.onTap,
  });

  final IconData icon;
  final String label;
  final VoidCallback onTap;

  @override
  Widget build(BuildContext context) {
    final width = (MediaQuery.sizeOf(context).width - 56) / 3;
    return SizedBox(
      width: width < 96 ? double.infinity : width,
      child: FilledButton.tonalIcon(
        onPressed: onTap,
        icon: Icon(icon, size: 18),
        label: Text(label, textAlign: TextAlign.center),
        style: FilledButton.styleFrom(
          minimumSize: const Size.fromHeight(52),
          padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 12),
        ),
      ),
    );
  }
}
